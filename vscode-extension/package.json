{
  "name": "shortcut-launcher",
  "displayName": "Shortcut Launcher",
  "description": "Search 250+ Windows / Office / VS Code / Git / GDB shortcuts and commands with Chinese descriptions. Copy commands or view keycaps without leaving VS Code.",
  "version": "0.2.3",
  "publisher": "neilwang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Neil-Wang-2085/shortcut-launcher.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "shortcut",
    "cheatsheet",
    "keyboard",
    "chinese",
    "commands",
    "productivity"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:shortcutLauncher.search"
  ],
  "contributes": {
    "commands": [
      {
        "command": "shortcutLauncher.search",
        "title": "Search Shortcuts & Commands",
        "category": "Shortcut Launcher"
      },
      {
        "command": "shortcutLauncher.addEntry",
        "title": "Add Custom Command",
        "category": "Shortcut Launcher"
      },
      {
        "command": "shortcutLauncher.importEntries",
        "title": "Import Custom Entries (JSON)",
        "category": "Shortcut Launcher"
      },
      {
        "command": "shortcutLauncher.importFolder",
        "title": "Import Commands from Folder…",
        "category": "Shortcut Launcher"
      },
      {
        "command": "shortcutLauncher.openEntriesFile",
        "title": "Open Custom Entries File",
        "category": "Shortcut Launcher"
      },
      {
        "command": "shortcutLauncher.deleteEntry",
        "title": "Delete Custom Entry",
        "category": "Shortcut Launcher"
      }
    ],
    "keybindings": [
      {
        "command": "shortcutLauncher.search",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      },
      {
        "command": "shortcutLauncher.addEntry",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  }
}
