[
  { "id": "build.cmake-configure", "app": "build", "type": "command", "title": "CMake configure", "command": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug", "description": "Configure a project into build/ with Debug type", "tags": ["cmake", "configure"], "platform": "all", "builtin": true },
